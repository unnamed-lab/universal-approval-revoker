# Port to listen on
PORT=3001

# Helius RPC URL (used for getParsedTokenAccountsByOwner)
# Format: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Helius API key (used for DAS metadata API)
HELIUS_API_KEY=YOUR_HELIUS_API_KEY_HERE

# Allowed CORS origin for the frontend
FRONTEND_URL=http://localhost:3000
