# Port to listen on
PORT=3001

# Helius RPC URL (used for getParsedTokenAccountsByOwner)
# Format: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# Helius API key (used for DAS metadata API)
HELIUS_API_KEY=YOUR_HELIUS_API_KEY_HERE

# Allowed CORS origin for the frontend
FRONTEND_URL=http://localhost:3000

# ─── EVM chain configuration ───
# At least one explorer API key is required for EVM scanning.
# RPC URLs are optional (needed for on-chain metadata + allowance checks).

# Ethereum mainnet (chain ID 1)
ETHERSCAN_API_KEY=
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Base (chain ID 8453)
BASESCAN_API_KEY=
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Arbitrum (chain ID 42161)
ARBISCAN_API_KEY=
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
